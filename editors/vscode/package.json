        {
          "command": "oak.openFileOnWeb",
          "group": "7_oak@2",
          "when": "oak.hasRepository && !explorerResourceIsFolder"
        }
      ],
      "view/title": [
        {
          "command": "oak.history.clearFilter",
          "group": "navigation@1",
          "when": "view == oak.history && oak.historyFiltered"
        },
        {
          "command": "oak.viewFileHistory",
          "group": "navigation@2",
          "when": "view == oak.history"
        },
        {
          "command": "oak.history.refresh",
          "group": "navigation@3",
          "when": "view == oak.history"
        }
      ],
      "view/item/context": [
        {
          "command": "oak.history.openCommitChanges",
          "group": "inline@1",
          "when": "view == oak.history && viewItem =~ /^commit/"
        },
        {
          "command": "oak.history.openCommitChanges",
          "group": "1_open@1",
          "when": "view == oak.history && viewItem =~ /^commit(:head)?$/"
        },
        {
          "command": "oak.history.copyHash",
          "group": "2_copy@1",
          "when": "view == oak.history && viewItem =~ /^commit(:head)?$/"
        },
        {
          "command": "oak.history.openCommitOnWeb",
          "group": "2_copy@2",
          "when": "view == oak.history && viewItem =~ /^commit(:head)?$/"
        },
        {
          "command": "oak.history.switchDetached",
          "group": "3_checkout@1",
          "when": "view == oak.history && viewItem == commit"
        },
        {
          "command": "oak.history.openFileChange",
          "group": "inline@1",
          "when": "view == oak.history && viewItem =~ /^commitFile/"
        },
        {
          "command": "oak.history.openFileChange",
          "group": "1_open@1",
          "when": "view == oak.history && viewItem =~ /^commitFile/"
        },
        {
          "command": "oak.history.openFileAtRevision",
          "group": "1_open@2",
          "when": "view == oak.history && viewItem =~ /^commitFile/"
        },
        {
          "command": "oak.history.compareWithWorkingTree",
          "group": "1_open@3",
          "when": "view == oak.history && viewItem =~ /^commitFile:(added|modified|renamed)/"
        },
        {
          "command": "oak.history.restoreFile",
          "group": "2_restore@1",
          "when": "view == oak.history && viewItem =~ /^commitFile/"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "oak.history",
          "name": "Oak History",
          "when": "oak.hasRepository",
          "icon": "$(history)",
          "contextualTitle": "Oak"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "scm",
        "contents": "The folder currently open is not an Oak repository.\n[Initialize Oak Repository](command:oak.init)\n[Clone from oak.space](command:oak.clone)\nLearn more about [Oak](https://oak.space/docs).",
        "when": "config.oak.enabled && oak.state == initialized && !oak.hasRepository && workbenchState != empty && !oak.missing"
      },
      {
        "view": "scm",
        "contents": "Open a folder to use Oak, or clone a repository.\n[Clone from oak.space](command:oak.clone)",
        "when": "config.oak.enabled && oak.state == initialized && workbenchState == empty && !oak.missing"
      },
      {
        "view": "scm",
        "contents": "The `oak` CLI was not found. Install it from [oak.space](https://oak.space/docs) or set [oak.path](command:workbench.action.openSettings?%5B%22oak.path%22%5D).",
        "when": "config.oak.enabled && oak.missing"
      }
    ],
    "colors": [
      {
        "id": "oakDecoration.addedResourceForeground",
        "description": "Color for added Oak resources.",
        "defaults": {
          "light": "#587c0c",
          "dark": "#81b88b",
          "highContrast": "#a1e3ad",
          "highContrastLight": "#374e06"
        }
      },
      {
        "id": "oakDecoration.modifiedResourceForeground",
        "description": "Color for modified Oak resources.",
        "defaults": {
          "light": "#895503",
          "dark": "#E2C08D",
          "highContrast": "#E2C08D",
          "highContrastLight": "#895503"
        }
      },
      {
        "id": "oakDecoration.deletedResourceForeground",
        "description": "Color for deleted Oak resources.",
        "defaults": {
          "light": "#ad0707",
          "dark": "#c74e39",
          "highContrast": "#c74e39",
          "highContrastLight": "#ad0707"
        }
      },
      {
        "id": "oakDecoration.renamedResourceForeground",
        "description": "Color for renamed Oak resources.",
        "defaults": {
          "light": "#007100",
          "dark": "#73C991",
          "highContrast": "#73C991",
          "highContrastLight": "#007100"
        }
      },
      {
        "id": "oakDecoration.conflictingResourceForeground",
        "description": "Color for Oak resources with conflicts.",
        "defaults": {
          "light": "#ad0707",
          "dark": "#e4676b",
          "highContrast": "#c74e39",
          "highContrastLight": "#ad0707"
        }
      }
    ],
    "configuration": {
      "title": "Oak",
      "properties": {
        "oak.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Oak source control."
        },
        "oak.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "machine",
          "description": "Path to the `oak` executable. Defaults to `oak` on PATH (also checks ~/.cargo/bin, ~/.local/bin, /opt/homebrew/bin, /usr/local/bin)."
        },
        "oak.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh status when files in the repository change."
        },
        "oak.autofetch": {
          "type": "boolean",
          "default": false,
          "description": "Periodically run `oak fetch` to refresh the local copy of main."
        },
        "oak.autofetchPeriod": {
          "type": "number",
          "default": 180,
          "minimum": 30,
          "description": "Seconds between automatic fetches when `oak.autofetch` is on."
        },
        "oak.confirmSync": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before synchronizing (pull, then push)."
        },
        "oak.postCommitCommand": {
          "type": "string",
          "enum": [
            "none",
            "push"
          ],
          "enumDescriptions": [
            "Do nothing after a checkpoint.",
            "Push the branch after every checkpoint."
          ],
          "default": "none",
          "description": "Action to run after a successful checkpoint."
        },
        "oak.promptToPushAfterCommit": {
          "type": "boolean",
          "default": true,
          "description": "After a checkpoint that wasn't pushed, offer to push it (with \"Always Push\" to switch `oak.postCommitCommand` to `push`)."
        },
        "oak.promptToSaveFilesBeforeCommit": {
          "type": "string",
          "enum": [
            "always",
            "prompt",
            "never"
          ],
          "enumDescriptions": [
            "Save dirty files in the repository automatically before checkpointing.",
            "Ask before saving.",
            "Checkpoint what is on disk."
          ],
          "default": "always",
          "description": "Whether unsaved files are saved before a checkpoint."
        },
        "oak.showBranchChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show a Branch Changes group listing everything the branch changed since it forked from its parent."
        },
        "oak.countBadge": {
          "type": "string",
          "enum": [
            "all",
            "off"
          ],
          "default": "all",
          "description": "Controls the Oak count badge on the Source Control icon."
        },
        "oak.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show change badges and colors in the Explorer and editor tabs."
        },
        "oak.ci.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show oak.space CI status for the current branch head in the status bar."
        },
        "oak.ci.pollInterval": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "description": "Seconds between CI status polls while a run is in progress."
        },
        "oak.repositoryScanMaxDepth": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "How many folder levels below each workspace folder to scan for Oak repositories."
        },
        "oak.historyPageSize": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "description": "Number of commits loaded at a time in the Oak History view."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:unit": "npm run compile && node --test out/test/unit/*.test.js",
    "test:integration": "npm run compile && node ./out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.86.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
