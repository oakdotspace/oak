      "scm/title": [
        {
          "command": "oak.commit",
          "group": "navigation@1",
          "when": "scmProvider == oak"
        },
        {
          "command": "oak.push",
          "group": "navigation@1.5",
          "when": "scmProvider == oak"
        },
        {
          "command": "oak.refresh",
          "group": "navigation@2",
          "when": "scmProvider == oak"
        },
        {
          "submenu": "oak.commitMenu",
          "group": "1_header@1",
          "when": "scmProvider == oak"
        },
        {
          "submenu": "oak.remoteMenu",
          "group": "1_header@2",
          "when": "scmProvider == oak"
        },
        {
