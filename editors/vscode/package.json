{
  "name": "oak-vcs",
  "displayName": "Oak Version Control",
  "description": "Oak version control for VS Code: source control view, quick diff, history, branches, sync, merge and CI for oak.space repositories.",
  "version": "0.1.0",
  "preview": true,
  "pricing": "Free",
  "publisher": "oak",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "light"
  },
  "homepage": "https://oak.space",
  "bugs": {
    "url": "https://oak.space/discord"
  },
  "repository": {
    "type": "oak",
    "url": "https://oak.space/oak/oak",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "oak",
    "vcs",
    "scm",
    "version control",
    "oak.space"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:.oak/oak.db",
    "workspaceContains:*/.oak/oak.db",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Oak runs the `oak` CLI in the workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "oak.refresh",
        "title": "Refresh",
        "category": "Oak",
        "icon": "$(refresh)"
      },
      {
        "command": "oak.init",
        "title": "Initialize Repository",
        "category": "Oak"
      },
      {
        "command": "oak.clone",
        "title": "Clone Repository...",
        "category": "Oak"
      },
      {
        "command": "oak.login",
        "title": "Log In to oak.space",
        "category": "Oak"
      },
      {
        "command": "oak.showOutput",
        "title": "Show Output",
        "category": "Oak"
      },
      {
        "command": "oak.commit",
        "title": "Checkpoint",
        "category": "Oak",
        "icon": "$(check)"
      },
      {
        "command": "oak.commitAndPush",
        "title": "Checkpoint & Push",
        "category": "Oak",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "oak.commitSelected",
        "title": "Checkpoint Selected Files",
        "category": "Oak",
        "icon": "$(check)"
      },
      {
        "command": "oak.saveDescription",
        "title": "Save Branch Description",
        "category": "Oak",
        "icon": "$(save)"
      },
      {
        "command": "oak.finish",
        "title": "Finish Branch (describe, checkpoint, publish)",
        "category": "Oak",
        "icon": "$(pass)"
      },
      {
        "command": "oak.openResource",
        "title": "Open Resource",
        "category": "Oak"
      },
      {
        "command": "oak.openChange",
        "title": "Open Changes",
        "category": "Oak",
        "icon": "$(git-compare)"
      },
      {
        "command": "oak.openFile",
        "title": "Open File",
        "category": "Oak",
        "icon": "$(go-to-file)"
      },
      {
        "command": "oak.openHEADFile",
        "title": "Open File (HEAD)",
        "category": "Oak"
      },
      {
        "command": "oak.openAllChanges",
        "title": "Open All Changes",
        "category": "Oak",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "oak.discard",
        "title": "Discard Changes",
        "category": "Oak",
        "icon": "$(discard)"
      },
      {
        "command": "oak.discardAll",
        "title": "Discard All Changes",
        "category": "Oak",
        "icon": "$(discard)"
      },
      {
        "command": "oak.push",
        "title": "Push",
        "category": "Oak",
        "icon": "$(repo-push)"
      },
      {
        "command": "oak.pushForce",
        "title": "Push (Force)",
        "category": "Oak"
      },
      {
        "command": "oak.publish",
        "title": "Publish to oak.space...",
        "category": "Oak",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "oak.pull",
        "title": "Pull",
        "category": "Oak",
        "icon": "$(arrow-down)"
      },
      {
        "command": "oak.pullForce",
        "title": "Pull (Force)",
        "category": "Oak"
      },
      {
        "command": "oak.fetch",
        "title": "Fetch main",
        "category": "Oak"
      },
      {
        "command": "oak.sync",
        "title": "Sync",
        "category": "Oak",
        "icon": "$(sync)"
      },
      {
        "command": "oak.merge",
        "title": "Merge Branch into main...",
        "category": "Oak",
        "icon": "$(git-merge)"
      },
      {
        "command": "oak.mergeWait",
        "title": "Merge Branch into main (wait for CI)",
        "category": "Oak",
        "icon": "$(git-merge)"
      },
      {
        "command": "oak.switchBranch",
        "title": "Switch Branch...",
        "category": "Oak",
        "icon": "$(git-branch)"
      },
      {
        "command": "oak.createBranch",
        "title": "Create Branch...",
        "category": "Oak",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "oak.createBranchClean",
        "title": "Create Branch from Clean main...",
        "category": "Oak"
      },
      {
        "command": "oak.renameBranch",
        "title": "Rename Branch...",
        "category": "Oak"
      },
      {
        "command": "oak.closeBranch",
        "title": "Close Branch...",
        "category": "Oak"
      },
      {
        "command": "oak.takeOurs",
        "title": "Accept Ours (this branch)",
        "category": "Oak",
        "icon": "$(arrow-left)"
      },
      {
        "command": "oak.takeTheirs",
        "title": "Accept Theirs (incoming)",
        "category": "Oak",
        "icon": "$(arrow-right)"
      },
      {
        "command": "oak.continue",
        "title": "Continue Merge/Pull",
        "category": "Oak",
        "icon": "$(debug-continue)"
      },
      {
        "command": "oak.abort",
        "title": "Abort Merge/Pull",
        "category": "Oak",
        "icon": "$(debug-stop)"
      },
      {
        "command": "oak.ci.showStatus",
        "title": "Show CI Status",
        "category": "Oak",
        "icon": "$(pulse)"
      },
      {
        "command": "oak.ci.showRuns",
        "title": "Show CI Runs...",
        "category": "Oak",
        "icon": "$(list-unordered)"
      },
      {
        "command": "oak.openOnWeb",
        "title": "Open on oak.space",
        "category": "Oak",
        "icon": "$(link-external)"
      },
      {
        "command": "oak.openFileOnWeb",
        "title": "Open File on oak.space",
        "category": "Oak",
        "icon": "$(link-external)"
      },
      {
        "command": "oak.copyReviewUrl",
        "title": "Copy Review URL",
        "category": "Oak",
        "icon": "$(copy)"
      },
      {
        "command": "oak.viewFileHistory",
        "title": "View File History",
        "category": "Oak",
        "icon": "$(history)"
      },
      {
        "command": "oak.history.clearFilter",
        "title": "Show All History",
        "category": "Oak",
        "icon": "$(clear-all)"
      },
      {
        "command": "oak.history.refresh",
        "title": "Refresh History",
        "category": "Oak",
        "icon": "$(refresh)"
      },
      {
        "command": "oak.history.loadMore",
        "title": "Load More",
        "category": "Oak"
      },
      {
        "command": "oak.history.openFileChange",
        "title": "Open Changes",
        "category": "Oak",
        "icon": "$(git-compare)"
      },
      {
        "command": "oak.history.openCommitChanges",
        "title": "Open Commit Changes",
        "category": "Oak",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "oak.history.copyHash",
        "title": "Copy Commit Hash",
        "category": "Oak",
        "icon": "$(copy)"
      },
      {
        "command": "oak.history.openCommitOnWeb",
        "title": "Open Commit on oak.space",
        "category": "Oak",
        "icon": "$(link-external)"
      },
      {
        "command": "oak.history.switchDetached",
        "title": "Checkout Commit (Detached)",
        "category": "Oak"
      },
      {
        "command": "oak.history.openFileAtRevision",
        "title": "Open File at Revision",
        "category": "Oak",
        "icon": "$(go-to-file)"
      },
      {
        "command": "oak.history.compareWithWorkingTree",
        "title": "Compare with Working Tree",
        "category": "Oak",
        "icon": "$(compare-changes)"
      },
      {
        "command": "oak.history.restoreFile",
        "title": "Restore File from This Commit",
        "category": "Oak",
        "icon": "$(discard)"
      }
    ],
    "submenus": [
      {
        "id": "oak.commitMenu",
        "label": "Checkpoint"
      },
      {
        "id": "oak.remoteMenu",
        "label": "Pull, Push"
      },
      {
        "id": "oak.branchMenu",
        "label": "Branch"
      },
      {
        "id": "oak.conflictMenu",
        "label": "Conflicts"
      },
      {
        "id": "oak.ciMenu",
        "label": "CI"
      }
    ],
