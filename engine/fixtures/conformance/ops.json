    {
      "name": "template-godot",
      "request": {
        "args": {
          "engine": "godot"
        },
        "op": "ignore.template",
        "v": 1
      },
      "response": {
        "ok": true,
        "result": {
          "contents": "# Godot\n# Per-machine editor cache, regenerated from the *.import sidecars. Those and\n# the *.uid sidecars must stay versioned: they keep resource ids stable.\n.godot/\n.import/\n*.translation\n\n# Export output and credentials\nbuild/\nexport/\n*.pck\n*.zip\n*.apk\n*.aab\n*.exe\n*.dmg\nexport_presets.cfg.secret\n\n# OS noise\n.DS_Store\nThumbs.db\n"
        },
        "v": 1
      },
      "source": "spec"
    },
    {
      "name": "template-unity",
      "request": {
        "args": {
          "engine": "unity"
        },
        "op": "ignore.template",
        "v": 1
      },
      "response": {
        "ok": true,
        "result": {
          "contents": "# Unity\n# Keep Assets/, Packages/ and ProjectSettings/, and every *.meta in them.\n[Ll]ibrary/\n[Tt]emp/\n[Oo]bj/\n[Ll]ogs/\n[Uu]serSettings/\nMemoryCaptures/\nRecordings/\n\n# Build output\n[Bb]uild/\n[Bb]uilds/\n\n# IDE project files, regenerated by Unity\n*.csproj\n*.sln\n*.slnf\n*.user\n.vs/\n.idea/\n.vsconfig\n\n# Crash and profiler artifacts\nsysinfo.txt\n*.stackdump\ncrashlytics-build.properties\n\n# OS noise\n.DS_Store\nThumbs.db\n"
        },
        "v": 1
      },
      "source": "spec"
    },
    {
      "name": "template-unreal",
      "request": {
        "args": {
          "engine": "unreal"
        },
        "op": "ignore.template",
        "v": 1
      },
      "response": {
        "ok": true,
        "result": {
          "contents": "# Unreal Engine\n# Keep the .uproject, Config/, Content/, Source/ and plugin sources.\nBinaries/\nPlugins/*/Binaries/\nIntermediate/\nPlugins/*/Intermediate/\nDerivedDataCache/\nSaved/\n\n# Cooked and packaged output\nCooked/\nPackaged/\n\n# IDE and generated project files\n.vs/\n.idea/\n.vscode/\n*.sln\n*.suo\n*.opensdf\n*.sdf\n*.VC.db\n*.VC.opendb\n*.vcxproj\n*.vcxproj.filters\n*.xcworkspace\n*.xcodeproj\n*.DotSettings.user\n\n# OS noise\n.DS_Store\nThumbs.db\nDesktop.ini\n"
        },
        "v": 1
      },
      "source": "spec"
